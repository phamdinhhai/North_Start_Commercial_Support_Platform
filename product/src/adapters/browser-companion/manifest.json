{
  "manifest_version": 3,
  "name": "North Star Research Companion",
  "version": "0.1.2",
  "description": "Experimental, user-activated Pancake WebSocket metadata observer. Local storage only.",
  "permissions": ["activeTab", "debugger", "storage"],
  "background": { "service_worker": "worker.mjs", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
