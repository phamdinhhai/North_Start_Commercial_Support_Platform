# North Star — local dev env (do NOT commit real secrets)
# Copy to product/.env and fill values

POSTGRES_DB=north_star
POSTGRES_USER=north_star
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Set DATABASE_URL in your local environment to override POSTGRES_*; do not commit credentials.
# DATABASE_URL=

# Optional bootstrap auth stub (OPEN: PM-1); supply a secret via deployment environment.
# x-bootstrap-token grants bootstrap admin while BOOTSTRAP_TOKEN is set; no user is seeded.
# BOOTSTRAP_TOKEN=

PORT=3000
NODE_ENV=development

# Production/pilot require PostgreSQL; any configured DATABASE_URL/POSTGRES_* selects
# PostgreSQL in local/demo/test too. Only explicitly selected local/demo/test memory
# mode avoids PostgreSQL; it is non-durable. Remove this setting to use the DB above.
DEPLOYMENT_MODE=local
# PILOT_STORE_MODE=memory
