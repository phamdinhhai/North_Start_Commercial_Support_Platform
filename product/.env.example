# North Star — local dev env (do NOT commit real secrets)
# Copy to product/.env and fill values

POSTGRES_DB=north_star
POSTGRES_USER=north_star
POSTGRES_PASSWORD=north_star
POSTGRES_PORT=5432
DATABASE_URL=postgres://north_star:north_star@localhost:5432/north_star

# One-time bootstrap admin (PH3 T3-03 stub — 1-A, OPEN: PM-1)
# Used only on first run to seed admin; remove after bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

PORT=3000
NODE_ENV=development
