{
  "name": "north-start-commercial-support-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Revenue Continuity Platform — Commercial support for acquisition → handoff → action → outcome → attribution",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:browser:install": "playwright install chromium",
    "test:integration": "vitest run integration --no-file-parallelism",
    "test:integration:ci": "node scripts/ci-integration.mjs",
    "test:backup": "node --test scripts/backup-verify.test.mjs",
    "test:architecture": "node --test scripts/check-architecture.test.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "migrate:up": "npm run build && node dist/scripts/migrate.js up",
    "migrate:down": "npm run build && node dist/scripts/migrate.js down",
    "db:up": "docker compose up -d postgres",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "security:audit": "npm audit --audit-level=high",
    "registry:validate": "node scripts/registry-validation.mjs",
    "test:registry": "node --test scripts/registry-validation.test.mjs",
    "architecture:check": "node scripts/check-architecture.mjs --report",
    "architecture:check:strict": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@playwright/test": "^1.56.1",
    "@nestjs/testing": "11.2.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "8.72.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.1",
    "typescript": "^5.7.0",
    "vitest": "5.1.0"
  }
}
